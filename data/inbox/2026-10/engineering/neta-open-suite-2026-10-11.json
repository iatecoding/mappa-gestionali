  "documents": [
    {
      "local_id": "document:neta-platform",
      "source_ref": "source:neta-platform",
      "title": "Neta - Energy & Utilities Platform",
      "document_type": "web_page",
      "extraction_method": "web_manual_excerpt",
      "text": "Neta è la piattaforma software Energy & Utilities di Engineering. Copre Meter to Cash (metering, billing, credit management), la relazione con i clienti (CRM, digital self service, portali distribuzione), post-fatturazione/pagamenti/contabilità (NetaPay, NetaSIAL), prodotti complementari (gestione agenti, comunità energetiche, previsioni consumi, settlement), AI & Analytics e il Portale Normativo. Oltre 150 clienti nazionali e internazionali."
    },
    {
      "local_id": "document:neta-brochure",
      "source_ref": "source:neta-brochure",
      "title": "Neta Open Suite - brochure",
      "document_type": "pdf_document",
      "extraction_method": "web_manual_excerpt",
      "text": "Neta Open Suite è la soluzione Customer Information System (CIS) leader per la gestione dei processi Meter2Cash e dei processi chiave degli operatori Energy & Utilities. Offre soluzioni SaaS con Cloud, Artificial Intelligence e Machine Learning; è abilitata dalla Neta Open Platform con API e Data Lakehouse Management. Copre Metering, Billing, Credit Management, Accounting/Logistics, CRM, Energy Communities, Distribution."
    }
  ],
