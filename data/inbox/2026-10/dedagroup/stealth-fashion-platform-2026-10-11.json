  "documents": [
    {
      "local_id": "document:deda-stealth-bestinclass",
      "source_ref": "source:deda-stealth-bestinclass",
      "title": "Best-in-class Software Solutions - Deda Stealth",
      "document_type": "web_page",
      "extraction_method": "web_manual_excerpt",
      "text": "Dedagroup Stealth combina conoscenza del settore Fashion & Luxury e tecnologia per offrire una soluzione retail completa. Stealth® The Fashion Platform gestisce i processi chiave della supply chain. Le soluzioni abilitano strategie omnichannel; tra i processi gestiti e le funzioni integrate: PDM/PLM, Finance (SAP, Oracle JD Edwards), POS (Retail Pro Prism), CRM ed e-commerce, WMS, Planning/MES, RFID. Integrazione con oltre cinquanta soluzioni best-in-class."
    },
    {
      "local_id": "document:deda-stealth-mccartney",
      "source_ref": "source:deda-stealth-mccartney",
      "title": "Deda Stealth in Stella McCartney stores worldwide",
      "document_type": "web_page",
      "extraction_method": "web_manual_excerpt",
      "text": "Il progetto di trasformazione digitale di Stella McCartney usa la Stealth Platform, che gestisce tutti i processi specifici del mondo fashion: dalla produzione e approvvigionamento alle vendite e distribuzione, abilitando strategie omnichannel e garantendo controllo ottimale di dati e processi lungo la catena del valore."
    }
