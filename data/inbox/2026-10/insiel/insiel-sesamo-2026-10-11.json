  "documents": [
    {
      "local_id": "document:insiel-sesamo-portal",
      "source_ref": "source:insiel-sesamo-portal",
      "title": "SESAMO - Piattaforma elettronica di servizi salute in mobilità",
      "document_type": "web_page",
      "extraction_method": "web_manual_excerpt",
      "text": "Sesamo è il portale dedicato alla Salute della Regione Friuli-Venezia Giulia: offre servizi sanitari ad accesso veloce (orari medici, farmacie di turno, guardie mediche, pronto soccorso, richiesta/annullamento/pagamento di prestazioni e ritiro referti di laboratorio) e l'accesso sicuro al Fascicolo Sanitario Elettronico, dove è custodita la documentazione sanitaria prodotta nelle strutture pubbliche e private convenzionate regionali."
    },
    {
      "local_id": "document:insiel-sanita",
      "source_ref": "source:insiel-sanita",
      "title": "Insiel - Sanità",
      "document_type": "web_page",
      "extraction_method": "web_manual_excerpt",
      "text": "Se.Sa.Mo è il portale regionale della Sanità Digitale. Attraverso Se.Sa.Mo i cittadini residenti in regione possono accedere, utilizzando SPID o la Carta Regionale dei Servizi, al proprio Fascicolo Sanitario Elettronico (FSE FVG). Insiel assicura l'operatività dei servizi digitali del Sistema Informativo Socio Sanitario Regionale."
    }
  ],
