  "documents": [
    {
      "local_id": "document:shopevolution-product",
      "source_ref": "source:shopevolution-product",
      "title": "Shopevolution 8 - pagina prodotto",
      "document_type": "web_page",
      "extraction_method": "web_manual_excerpt",
      "text": "Shopevolution 8 e' un software omnicanale di self-shopping con Scan and Go, gestione promozioni e tracciamento degli acquisti in tempo reale. Integra algoritmi di loss prevention basati su machine learning e AI, mobile device management (MDM), integrazione out-of-the-box con sistemi POS, programmi fedelta' e pricing engine tramite API flessibile. E' cloud-ready ed elimina la necessita' di server in negozio, con gestione multi-store."
    },
    {
      "local_id": "document:smart-vision-press",
      "source_ref": "source:smart-vision-press",
      "title": "Smart Vision Suite for Retail - comunicato",
      "document_type": "press_release",
      "extraction_method": "web_manual_excerpt",
      "text": "Datalogic presenta Smart Vision Suite for Retail, una suite software AI per la loss prevention al checkout, integrata nei lettori Magellan 9600i e 9900i. I casi d'uso includono Produce Recognition, Label Switching e Multiple Item Detection, Mis-scan Detection. L'architettura e' embedded con Tensor Processing Unit (TPU), switch PoE e SDK/API per l'integrazione con POS/SCO."
    }
  ],
