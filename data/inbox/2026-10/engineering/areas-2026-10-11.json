  "documents": [
    {
      "local_id": "document:areas-platform",
      "source_ref": "source:areas-platform",
      "title": "AREAS - Engineering Group",
      "document_type": "web_page",
      "extraction_method": "web_manual_excerpt",
      "text": "AREAS® è la piattaforma sviluppata da Engineering per il settore healthcare, scelta da più di 160 strutture sanitarie e usata ogni giorno da oltre 100.000 professionisti sanitari. È composta da sistemi indipendenti organizzati in sette aree applicative nativamente integrate: Governance, Access Management, Hospital, Community Care, Diagnostics, Administration and Control, Human Resources. Grazie a certificazioni e codifiche internazionali comunica con sistemi di terze parti, progetti regionali/nazionali, dispositivi medicali e strumenti di laboratorio; è allineata a normative civili, fiscali e del lavoro, firma elettronica, GDPR e conservazione sostitutiva."
    },
    {
      "local_id": "document:eng-ehealth-wp",
      "source_ref": "source:eng-ehealth-wp",
      "title": "E-HEALTH - white paper Engineering",
      "document_type": "pdf_document",
      "extraction_method": "web_manual_excerpt",
      "text": "Engineering dedica oltre 900 professionisti alla sanità elettronica. AREAS da oltre dieci anni è la risposta applicativa di riferimento per l'informatizzazione diffusa e integrata di tutti i processi della sanità, da quelli clinico-diagnostici a quelli amministrativi e contabili; con oltre 100.000 utenti. La piattaforma ellipse porta il software per l'E-Health su un livello più evoluto e specialistico, focalizzato sulla dimensione clinica."
    }
  ],
