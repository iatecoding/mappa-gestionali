  "documents": [
    {
      "local_id": "document:vivaticket-ticketing",
      "source_ref": "source:vivaticket-ticketing",
      "title": "Ticketing system - funzioni principali",
      "document_type": "web_page",
      "extraction_method": "web_manual_excerpt",
      "text": "Vivaticket Ticketing System e' una soluzione unica per vendite, marketing e coinvolgimento clienti. Funzioni principali: biglietteria web responsive multilingua e multivaluta, prezzi dinamici con integrazione AI via API, cashless, membership e abbonamenti, assegnazione posto (posti liberi, assegnati, selezione su mappa anche 3D), eventi a fasce orarie, full offline management, multi-tenant (server locale, cloud o ibrido) e chioschi Kiosk (TVM) per ritiro e vendita biglietti."
    },
    {
      "local_id": "document:vivaticket-access-control",
      "source_ref": "source:vivaticket-access-control",
      "title": "Access control - funzioni",
      "document_type": "web_page",
      "extraction_method": "web_manual_excerpt",
      "text": "L'access control Vivaticket si integra con tornelli, lettori laser o a immagine, dispositivi Android tramite app proprietaria Gatekeeper, e supporta barcode, QR code, banda magnetica, RFID contact/proximity, UHF, NFC e lettori biometrici. Include riconoscimento facciale, Frictionless Engine con accesso contactless, QR code dinamico antifrode, gestione offline e multi-venue."
    }
  ],
